# Copy to .env.local and fill in. Local values come from `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key (bypasses row-level security). Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Local test owner account created by `pnpm dev:owner`. Local development only.
DEV_OWNER_EMAIL=owner@wfh.test
DEV_OWNER_PASSWORD=MwJnaX9pwlq_aMK2

# Shared secret that signs webhooks between the website and the ordering backend.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SIGNING_SECRET=
# Public URL of this app (webhooks and links). Locally http://localhost:3100.
SITE_URL=http://localhost:3100

# Browser push notifications. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: road distances for delivery fees (https://openrouteservice.org). Without it, straight line × 1.3.
OPENROUTESERVICE_API_KEY=

# Map tiles. OpenStreetMap's tiles are fine for development; use MapTiler (or similar) in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Show "Continue with Facebook" once the Meta app is set up in Supabase Auth.
NEXT_PUBLIC_FACEBOOK_LOGIN=off

# Local test customer created by `pnpm dev:customer` (signs in at /login in development only).
DEV_CUSTOMER_EMAIL=customer@wfh.test
DEV_CUSTOMER_PASSWORD=csulc7DM0IP2L8Py

# SMS texts. SMS_PROVIDER: textbee (an Android phone sends from its own SIM) or philsms (needs a registered business).
# Without the chosen provider's key, or with SMS_DRY_RUN=true, texts are only logged in Admin > Texts.
SMS_PROVIDER=textbee
SMS_DRY_RUN=false
# textbee (https://textbee.dev > Dashboard): API key, and optionally which phone to use (blank = default phone).
# TEXTBEE_API_URL only when self-hosting textbee (e.g. https://sms.example.com/api/v1).
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_API_URL=
# PhilSMS (https://dashboard.philsms.com > Developers). The sender name must be approved on your account.
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=PhilSMS
