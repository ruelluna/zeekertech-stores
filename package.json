{
  "name": "weekend-food-hub",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema store,ops > packages/shared/src/database.types.ts",
    "dev:owner": "node --env-file=apps/web/.env.local scripts/dev-owner.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
