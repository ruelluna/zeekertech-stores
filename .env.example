# Copy to .env (root, used by Supabase CLI) and fill in.
# App-specific env files live in apps/web/.env.local and apps/staff/.env.

# Supabase (from `pnpm db:start` output locally, or the dashboard in production)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret used to sign webhooks between the web app and the ordering backend
WEBHOOK_SIGNING_SECRET=

# Facebook Login (Meta developer app) — used by Supabase Auth
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=

# Road distance for delivery fees
OPENROUTESERVICE_API_KEY=
